{
  "info": {
    "name": "Mini Jira",
    "description": "Phase 5 API. Run Login first; it saves the access token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000"},
    {"key": "token", "value": ""},
    {"key": "teamId", "value": ""},
    {"key": "projectId", "value": ""},
    {"key": "taskId", "value": ""},
    {"key": "labelId", "value": ""}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"secret12\",\n  \"full_name\": \"Ada\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/users"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"secret12\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Teams and projects",
      "item": [
        {
          "name": "Create team",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.collectionVariables.set('teamId', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Platform\"\n}"},
            "url": "{{baseUrl}}/api/v1/teams"
          }
        },
        {
          "name": "Create project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.collectionVariables.set('projectId', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Demo\"\n}"},
            "url": "{{baseUrl}}/api/v1/teams/{{teamId}}/projects"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.collectionVariables.set('taskId', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"First task\"\n}"},
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks"
          }
        },
        {
          "name": "Update task",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"status\": \"in_progress\"\n}"},
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}"
          }
        }
      ]
    },
    {
      "name": "Comments, labels, activity",
      "item": [
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"body\": \"Looks good\"\n}"},
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/comments"
          }
        },
        {
          "name": "List comments",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/comments"
          }
        },
        {
          "name": "Create label",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.collectionVariables.set('labelId', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"bug\",\n  \"color\": \"red\"\n}"},
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/labels"
          }
        },
        {
          "name": "Attach label",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"label_id\": {{labelId}}\n}"},
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/labels"
          }
        },
        {
          "name": "List activity",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/v1/tasks/{{taskId}}/activity"
          }
        }
      ]
    }
  ]
}

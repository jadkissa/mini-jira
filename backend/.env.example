# Copy to .env and adjust as needed:
#   cp .env.example .env

APP_NAME=Mini Jira
APP_DESCRIPTION=A simple project management tool
ENVIRONMENT=development
DEBUG=true

# Local (host machine talking to Compose Postgres on published port):
DATABASE_URL=postgresql+psycopg://mini_jira:mini_jira@localhost:5432/mini_jira

# Change this before any shared or deployed environment.
JWT_SECRET=dev-secret-change-me-use-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Inside Docker Compose, docker-compose.yml overrides this to use host `db`.
